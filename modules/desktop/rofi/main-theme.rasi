/* Neutral Slate Rofi Theme */
* {
    bg-col:     #16181a;
    bg-col-alt: #1e2124;
    border-col: #282c30;
    fg-col:     #d3d7dc;
    main:       #8f99a3;
    
    width: 600;
    font: "Iosevka Nerd Font 12";
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 360px;
    border: 2px;
    border-radius: 0px;
    border-color: @main; 
    background-color: @bg-col;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col;
    border-radius: 0px;
    padding: 10px;
}

prompt {
    background-color: @main; 
    padding: 6px;
    text-color: #16181a;
    border-radius: 0px;
    margin: 20px 0px 0px 20px;
}

entry {
    padding: 6px;
    margin: 20px 0px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col;
}

listview {
    border: 0px;
    padding: 6px 0px 0px;
    margin: 10px 20px 0px 20px;
    columns: 1;
    background-color: @bg-col;
}

element {
    padding: 8px;
    background-color: @bg-col;
    text-color: @fg-col;
}

element selected {
    background-color: #282c30; 
    text-color: #ffffff;
    border-radius: 0px;
}

element-icon {
    size: 24px;
}

element-text {
    margin: 0px 0px 0px 10px;
}

mode-switcher {
    spacing: 0;
    margin: 20px 0px 0px 0px;
}

button {
    padding: 10px;
    background-color: @bg-col-alt;
    text-color: @fg-col;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-col;
    text-color: #ffffff; 
}
