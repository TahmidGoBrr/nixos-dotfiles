/* Tokyo Night Theme - Blue & Purple Accents with Iosevka */
* {
    /* Base Colors */
    bg-col:     #1a1b26;  /* Tokyo Night Background */
    bg-col-alt: #16161e;  /* Tokyo Night Darker Background */
    border-col: #292e42;  /* Tokyo Night Border/Selection */
    fg-col:     #c0caf5;  /* Tokyo Night Foreground */
    fg-col2:    #f7768e;  /* Tokyo Night Red */
    
    /* Primary Accent */
    main:   #7aa2f7;  /* Blue: For row selections */
    
    width: 600;
    font: "Iosevka Nerd Font 12";
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 360px;
    border: 3px;
    border-radius: 0px;
    border-color: @main; 
    background-color: @bg-col;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt, entry];
    background-color: @bg-col;
    border-radius: 0px;
    padding: 10px;
}

prompt {
    background-color: @main; 
    padding: 6px;
    text-color: @bg-col;
    border-radius: 0px;
    margin: 20px 0px 0px 20px;
}

entry {
    padding: 6px;
    margin: 20px 0px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col;
}

listview {
    border: 0px;
    padding: 6px 0px 0px;
    margin: 10px 20px 0px 20px;
    columns: 1;
    background-color: @bg-col;
}

element {
    padding: 8px;
    background-color: @bg-col;
    text-color: @fg-col;
}

element selected {
    background-color: @main; 
    text-color: @bg-col-alt;
    border-radius: 0px;
}

element-icon {
    size: 24px;
}

element-text {
    margin: 0px 0px 0px 10px;
}

mode-switcher {
    spacing: 0;
    margin: 20px 0px 0px 0px;
}

button {
    padding: 10px;
    background-color: @bg-col-alt;
    text-color: @fg-col;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
}

button main {
    background-color: @bg-col;
    text-color: @main; 
}
